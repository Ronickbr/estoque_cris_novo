import { Row, Col, Card, Form, Button, Modal, Alert, Spinner, Avatar, Badge } from 'react-bootstrap';
import { useState, useCallback } from 'react';
import { useAuth } from '@hooks/useAuth';
import { useToastManager } from '@components/ui/Toast';
import { cn, formatDate, getInitials, getUserRoleLabel, getUserRoleColor } from '@utils';
import {
  Person, Mail, Lock, Key, Bell, Eye, EyeOff, Camera, Edit2, Save, X, CheckCircle, AlertCircle,
} from 'lucide-react';

export function Profile() {
  const { user, updateProfile, changePassword, isLoading: authLoading } = useAuth();
  const { success, danger, warning } = useToastManager();

  const [activeTab, setActiveTab] = useState<'profile' | 'password' | 'notifications' | 'sessions'>('profile');
  const [isEditing, setIsEditing] = useState(false);
  const [isSaving, setIsSaving] = useState(false);
  const [isChangingPassword, setIsChangingPassword] = useState(false);
  const [showDeleteConfirm, setShowDeleteConfirm] = useState(false);

  const [profileData, setProfileData] = useState({
    name: user?.name || '',
    email: user?.email || '',
    phone: '',
    avatar: user?.avatar || '',
  });

  const [passwordData, setPasswordData] = useState({
    currentPassword: '',
    newPassword: '',
    confirmPassword: '',
  });

  const [passwordErrors, setPasswordErrors] = useState<Record<string, string>>({});
  const [profileErrors, setProfileErrors] = useState<Record<string, string>>({});

  const notificationSettings = {
    emailAlerts: true,
    lowStockAlerts: true,
    movementAlerts: false,
    reportAlerts: true,
    weeklyDigest: false,
  };

  const handleProfileSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!validateProfile()) return;

    setIsSaving(true);
    try {
      await updateProfile(profileData);
      success('Sucesso', 'Perfil atualizado com sucesso');
      setIsEditing(false);
    } catch (error: unknown) {
      const message = error instanceof Error ? error.message : 'Erro ao atualizar perfil';
      danger('Erro', message);
    } finally {
      setIsSaving(false);
    }
  };

  const validateProfile = () => {
    const errors: Record<string, string> = {};
    if (!profileData.name.trim()) errors.name = 'Nome é obrigatório';
    if (!profileData.email.trim()) errors.email = 'E-mail é obrigatório';
    else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(profileData.email)) errors.email = 'E-mail inválido';
    setProfileErrors(errors);
    return Object.keys(errors).length === 0;
  };

  const handlePasswordSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!validatePassword()) return;

    setIsChangingPassword(true);
    try {
      await changePassword(passwordData.currentPassword, passwordData.newPassword);
      success('Sucesso', 'Senha alterada com sucesso');
      setPasswordData({ currentPassword: '', newPassword: '', confirmPassword: '' });
    } catch (error: unknown) {
      const message = error instanceof Error ? error.message : 'Erro ao alterar senha';
      danger('Erro', message);
    } finally {
      setIsChangingPassword(false);
    }
  };

  const validatePassword = () => {
    const errors: Record<string, string> = {};
    if (!passwordData.currentPassword) errors.currentPassword = 'Senha atual é obrigatória';
    if (!passwordData.newPassword) errors.newPassword = 'Nova senha é obrigatória';
    else if (passwordData.newPassword.length < 8) errors.newPassword = 'A senha deve ter pelo menos 8 caracteres';
    if (passwordData.newPassword !== passwordData.confirmPassword) errors.confirmPassword = 'As senhas não coincidem';
    setPasswordErrors(errors);
    return Object.keys(errors).length === 0;
  };

  const handleAvatarChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = (event) => {
        setProfileData((prev) => ({ ...prev, avatar: event.target?.result as string }));
      };
      reader.readAsDataURL(file);
    }
  };

  const tabs = [
    { id: 'profile', label: 'Perfil', icon: Person },
    { id: 'password', label: 'Senha', icon: Lock },
    { id: 'notifications', label: 'Notificações', icon: Bell },
    { id: 'sessions', label: 'Sessões', icon: Key },
  ];

  return (
    <div className="profile-page">
      <div className="page-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
          <h1 className="h2 fw-bold mb-1">Meu Perfil</h1>
          <p className="text-muted mb-0">Gerencie suas informações e preferências</p>
        </div>
      </div>

      <Row className="g-4">
        <Col lg={4}>
          <Card className="shadow-sm border-0 sticky-top" style={{ top: '24px' }}>
            <Card.Body className="text-center p-4">
              <div className="position-relative d-inline-block mb-3">
                <Avatar
                  src={profileData.avatar || (user?.email ? `https://ui-avatars.com/api/?name=${encodeURIComponent(user.name)}&background=445d6b&color=fff&size=120` : undefined)}
                  alt={user?.name || 'Usuário'}
                  className="rounded-circle"
                  size="xl"
                >
                  {getInitials(user?.name || 'Usuário')}
                </Avatar>
                {isEditing && (
                  <label className="position-absolute bottom-0 end-0 bg-primary text-white rounded-circle p-2 cursor-pointer" htmlFor="avatar-input">
                    <Camera size={16} aria-hidden="true" />
                    <input id="avatar-input" type="file" className="d-none" accept="image/*" onChange={handleAvatarChange} />
                  </label>
                )}
              </div>
              <h5 className="mb-1">{user?.name || 'Usuário'}</h5>
              <Badge className={cn(`bg-${getUserRoleColor(user?.role || 'viewer')}`)}>
                {getUserRoleLabel(user?.role || 'viewer')}
              </Badge>
              <div className="mt-3 pt-3 border-top">
                <p className="text-muted small mb-1">
                  <Mail className="me-1" size={14} aria-hidden="true" />
                  {user?.email}
                </p>
                <p className="text-muted small mb-0">
                  <Clock className="me-1" size={14} aria-hidden="true" />
                  Membro desde {formatDate(user?.createdAt || new Date())}
                </p>
              </div>
            </Card.Body>
          </Card>
        </Col>

        <Col lg={8}>
          <div className="h-100">
            <nav className="nav nav-pills mb-4" role="tablist">
              {tabs.map((tab) => (
                <Button
                  key={tab.id}
                  role="tab"
                  aria-selected={activeTab === tab.id}
                  onClick={() => { setActiveTab(tab.id as typeof activeTab); setIsEditing(false); }}
                  className={cn(
                    'nav-link',
                    'd-flex',
                    'align-items-center',
                    'gap-2',
                    'px-3',
                    'py-2',
                    'rounded-3',
                    'text-nowrap',
                    activeTab === tab.id ? 'bg-primary text-white' : 'bg-light text-dark hover:bg-primary-50 hover:text-primary'
                  )}
                  variant={activeTab === tab.id ? 'primary' : 'ghost'}
                >
                  <tab.icon size={16} aria-hidden="true" />
                  {tab.label}
                </Button>
              ))}
            </nav>

            {activeTab === 'profile' && (
              <Card className="shadow-sm border-0">
                <Card.Header className="bg-white border-0 d-flex justify-content-between align-items-center">
                  <h5 className="mb-0 fw-semibold">Informações Pessoais</h5>
                  {isEditing ? (
                    <Button variant="ghost" size="sm" onClick={() => { setIsEditing(false); setProfileData({ name: user?.name || '', email: user?.email || '', phone: '', avatar: user?.avatar || '' }); }}>
                      <X size={14} className="me-1" aria-hidden="true" />
                      Cancelar
                    </Button>
                  ) : (
                    <Button variant="outline-primary" size="sm" onClick={() => setIsEditing(true)}>
                      <Edit2 size={14} className="me-1" aria-hidden="true" />
                      Editar
                    </Button>
                  )}
                </Card.Header>
                <Card.Body>
                  <Form onSubmit={handleProfileSubmit} noValidate>
                    <div className="row g-3">
                      <div className="col-md-6">
                        <Form.Label>Nome Completo *</Form.Label>
                        <input
                          type="text"
                          className={`form-control ${profileErrors.name ? 'is-invalid' : ''}`}
                          value={profileData.name}
                          onChange={(e) => { setProfileData((p) => ({ ...p, name: e.target.value })); if (profileErrors.name) setProfileErrors((p) => ({ ...p, name: '' })); }}
                          disabled={!isEditing}
                          required
                          aria-invalid={profileErrors.name ? 'true' : 'false'}
                        />
                        {profileErrors.name && <div className="invalid-feedback d-block">{profileErrors.name}</div>}
                      </div>
                      <div className="col-md-6">
                        <Form.Label>E-mail *</Form.Label>
                        <input
                          type="email"
                          className={`form-control ${profileErrors.email ? 'is-invalid' : ''}`}
                          value={profileData.email}
                          onChange={(e) => { setProfileData((p) => ({ ...p, email: e.target.value })); if (profileErrors.email) setProfileErrors((p) => ({ ...p, email: '' })); }}
                          disabled={!isEditing}
                          required
                          aria-invalid={profileErrors.email ? 'true' : 'false'}
                        />
                        {profileErrors.email && <div className="invalid-feedback d-block">{profileErrors.email}</div>}
                      </div>
                      <div className="col-md-6">
                        <Form.Label>Telefone</Form.Label>
                        <input
                          type="tel"
                          className="form-control"
                          value={profileData.phone}
                          onChange={(e) => setProfileData((p) => ({ ...p, phone: e.target.value }))}
                          disabled={!isEditing}
                          placeholder="(00) 00000-0000"
                        />
                      </div>
                      <div className="col-md-6">
                        <Form.Label>Avatar URL</Form.Label>
                        <input
                          type="url"
                          className="form-control"
                          value={profileData.avatar}
                          onChange={(e) => setProfileData((p) => ({ ...p, avatar: e.target.value }))}
                          disabled={!isEditing}
                          placeholder="https://exemplo.com/avatar.jpg"
                        />
                      </div>
                    </div>
                    {isEditing && (
                      <div className="mt-4 d-flex justify-content-end gap-2">
                        <Button variant="secondary" onClick={() => { setIsEditing(false); setProfileData({ name: user?.name || '', email: user?.email || '', phone: '', avatar: user?.avatar || '' }); }}>
                          Cancelar
                        </Button>
                        <Button variant="primary" type="submit" disabled={isSaving}>
                          {isSaving ? (
                            <>
                              <Spinner as="span" size="sm" className="me-1" aria-hidden="true" />
                              Salvando...
                            </>
                          ) : (
                            <>
                              <Save size={16} className="me-1" aria-hidden="true" />
                              Salvar Alterações
                            </>
                          )}
                        </Button>
                      </div>
                    )}
                  </Form>
                </Card.Body>
              </Card>
            )}

            {activeTab === 'password' && (
              <Card className="shadow-sm border-0">
                <Card.Header className="bg-white border-0">
                  <h5 className="mb-0 fw-semibold">Alterar Senha</h5>
                </Card.Header>
                <Card.Body>
                  <Alert variant="info" className="mb-4">
                    <AlertCircle className="me-2" size={16} aria-hidden="true" />
                    Sua senha deve ter pelo menos 8 caracteres, incluindo letras maiúsculas, minúsculas, números e símbolos.
                  </Alert>
                  <Form onSubmit={handlePasswordSubmit} noValidate>
                    <div className="mb-3">
                      <Form.Label>Senha Atual *</Form.Label>
                      <div className="position-relative">
                        <input
                          type="password"
                          className={`form-control ${passwordErrors.currentPassword ? 'is-invalid' : ''}`}
                          value={passwordData.currentPassword}
                          onChange={(e) => { setPasswordData((p) => ({ ...p, currentPassword: e.target.value })); if (passwordErrors.currentPassword) setPasswordErrors((p) => ({ ...p, currentPassword: '' })); }}
                          required
                          aria-invalid={passwordErrors.currentPassword ? 'true' : 'false'}
                        />
                        {passwordErrors.currentPassword && <div className="invalid-feedback d-block">{passwordErrors.currentPassword}</div>}
                      </div>
                    </div>
                    <div className="mb-3">
                      <Form.Label>Nova Senha *</Form.Label>
                      <div className="position-relative">
                        <input
                          type="password"
                          className={`form-control ${passwordErrors.newPassword ? 'is-invalid' : ''}`}
                          value={passwordData.newPassword}
                          onChange={(e) => { setPasswordData((p) => ({ ...p, newPassword: e.target.value })); if (passwordErrors.newPassword) setPasswordErrors((p) => ({ ...p, newPassword: '' })); }}
                          required
                          minLength={8}
                          aria-invalid={passwordErrors.newPassword ? 'true' : 'false'}
                        />
                        {passwordErrors.newPassword && <div className="invalid-feedback d-block">{passwordErrors.newPassword}</div>}
                      </div>
                      <Form.Text>Mínimo 8 caracteres</Form.Text>
                    </div>
                    <div className="mb-3">
                      <Form.Label>Confirmar Nova Senha *</Form.Label>
                      <input
                        type="password"
                        className={`form-control ${passwordErrors.confirmPassword ? 'is-invalid' : ''}`}
                        value={passwordData.confirmPassword}
                        onChange={(e) => { setPasswordData((p) => ({ ...p, confirmPassword: e.target.value })); if (passwordErrors.confirmPassword) setPasswordErrors((p) => ({ ...p, confirmPassword: '' })); }}
                        required
                        aria-invalid={passwordErrors.confirmPassword ? 'true' : 'false'}
                      />
                      {passwordErrors.confirmPassword && <div className="invalid-feedback d-block">{passwordErrors.confirmPassword}</div>}
                    </div>
                    <Button variant="primary" type="submit" disabled={isChangingPassword}>
                      {isChangingPassword ? (
                        <>
                          <Spinner as="span" size="sm" className="me-1" aria-hidden="true" />
                          Alterando...
                        </>
                      ) : (
                        <>
                          <Key size={16} className="me-1" aria-hidden="true" />
                          Alterar Senha
                        </>
                      )}
                    </Button>
                  </Form>
                </Card.Body>
              </Card>
            )}

            {activeTab === 'notifications' && (
              <Card className="shadow-sm border-0">
                <Card.Header className="bg-white border-0">
                  <h5 className="mb-0 fw-semibold">Preferências de Notificação</h5>
                </Card.Header>
                <Card.Body>
                  <Form>
                    <div className="notification-settings">
                      <div className="notification-item d-flex justify-content-between align-items-center p-3 border-bottom">
                        <div>
                          <h6 className="mb-1">Alertas por E-mail</h6>
                          <p className="text-muted small mb-0">Receber notificações importantes por e-mail</p>
                        </div>
                        <div className="form-check form-switch">
                          <input
                            type="checkbox"
                            className="form-check-input"
                            id="email-alerts"
                            checked={notificationSettings.emailAlerts}
                            onChange={(e) => setNotificationSettings((p) => ({ ...p, emailAlerts: e.target.checked }))}
                          />
                        </div>
                      </div>
                      <div className="notification-item d-flex justify-content-between align-items-center p-3 border-bottom">
                        <div>
                          <h6 className="mb-1">Alertas de Estoque Baixo</h6>
                          <p className="text-muted small mb-0">Notificar quando produtos atingirem o estoque mínimo</p>
                        </div>
                        <div className="form-check form-switch">
                          <input
                            type="checkbox"
                            className="form-check-input"
                            id="low-stock-alerts"
                            checked={notificationSettings.lowStockAlerts}
                            onChange={(e) => setNotificationSettings((p) => ({ ...p, lowStockAlerts: e.target.checked }))}
                          />
                        </div>
                      </div>
                      <div className="notification-item d-flex justify-content-between align-items-center p-3 border-bottom">
                        <div>
                          <h6 className="mb-1">Alertas de Movimentação</h6>
                          <p className="text-muted small mb-0">Notificar sobre entradas e saídas de estoque</p>
                        </div>
                        <div className="form-check form-switch">
                          <input
                            type="checkbox"
                            className="form-check-input"
                            id="movement-alerts"
                            checked={notificationSettings.movementAlerts}
                            onChange={(e) => setNotificationSettings((p) => ({ ...p, movementAlerts: e.target.checked }))}
                          />
                        </div>
                      </div>
                      <div className="notification-item d-flex justify-content-between align-items-center p-3 border-bottom">
                        <div>
                          <h6 className="mb-1">Relatórios Periódicos</h6>
                          <p className="text-muted small mb-0">Receber relatórios automáticos por e-mail</p>
                        </div>
                        <div className="form-check form-switch">
                          <input
                            type="checkbox"
                            className="form-check-input"
                            id="report-alerts"
                            checked={notificationSettings.reportAlerts}
                            onChange={(e) => setNotificationSettings((p) => ({ ...p, reportAlerts: e.target.checked }))}
                          />
                        </div>
                      </div>
                      <div className="notification-item d-flex justify-content-between align-items-center p-3">
                        <div>
                          <h6 className="mb-1">Resumo Semanal</h6>
                          <p className="text-muted small mb-0">Receber resumo semanal de atividades</p>
                        </div>
                        <div className="form-check form-switch">
                          <input
                            type="checkbox"
                            className="form-check-input"
                            id="weekly-digest"
                            checked={notificationSettings.weeklyDigest}
                            onChange={(e) => setNotificationSettings((p) => ({ ...p, weeklyDigest: e.target.checked }))}
                          />
                        </div>
                      </div>
                    </div>
                  </Form>
                </Card.Body>
              </Card>
            )}

            {activeTab === 'sessions' && (
              <Card className="shadow-sm border-0">
                <Card.Header className="bg-white border-0">
                  <h5 className="mb-0 fw-semibold">Sessões Ativas</h5>
                </Card.Header>
                <Card.Body>
                  <Alert variant="info">
                    <InfoCircle className="me-2" size={16} aria-hidden="true" />
                    O gerenciamento de sessões ativas será implementado em uma versão futura.
                  </Alert>
                </Card.Body>
              </Card>
            )}

            <Card className="shadow-sm border-0 border-danger mt-4">
              <Card.Header className="bg-white border-0">
                <h5 className="mb-0 fw-semibold text-danger">Zona de Perigo</h5>
              </Card.Header>
              <Card.Body>
                <div className="d-flex justify-content-between align-items-center">
                  <div>
                    <h6 className="mb-1">Excluir Conta</h6>
                    <p className="text-muted small mb-0">Esta ação é irreversível. Todos os seus dados serão permanentemente removidos.</p>
                  </div>
                  <Button variant="danger" onClick={() => setShowDeleteConfirm(true)}>
                    Excluir Conta
                  </Button>
                </div>
              </Card.Body>
            </Card>
          </div>
        </Col>
      </Row>

      <Modal show={showDeleteConfirm} onHide={() => setShowDeleteConfirm(false)} size="sm" centered title="Confirmar exclusão da conta" confirmText="Excluir" confirmVariant="danger">
        <div className="text-center">
          <AlertCircle className="text-danger mb-3" size={48} aria-hidden="true" />
          <h5>Excluir conta permanentemente?</h5>
          <p className="text-muted">
            Esta ação não pode ser desfeita. Todos os seus dados, histórico e configurações serão removidos permanentemente.
          </p>
          <div className="form-check mb-3">
            <input type="checkbox" className="form-check-input" id="confirm-delete" />
            <label className="form-check-label" htmlFor="confirm-delete">
              Confirmo que desejo excluir minha conta permanentemente
            </label>
          </div>
        </div>
      </Modal>
    </div>
  );
}

function InfoCircle({ className, size }: { className?: string; size?: number }) {
  return (
    <svg className={className} width={size} height={size} viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
      <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm-3.5-6.5a.5.5 0 0 1-1 0V5.707L5.354 7.854a.5.5 0 1 1-.708-.708l3-3a.5.5 0 0 1 .708 0l3 3a.5.5 0 1 1-.708.708L8.5 5.707V9.5a.5.5 0 0 1-1 0V5.707L5.354 7.854a.5.5 0 1 1-.708-.708l3-3a.5.5 0 0 1 .708 0l3 3a.5.5 0 1 1-.708.708L8.5 5.707V9.5a.5.5 0 0 1-1 0V5.707z" />
    </svg>
  );
}

function setNotificationSettings(_: any) {
  // TODO: Implement notification settings persistence
}

export default Profile;