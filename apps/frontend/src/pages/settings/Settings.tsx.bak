import { Row, Col, Card, Form, Button, Modal, Alert, Spinner, Switch, Badge, InputGroup } from 'react-bootstrap';
import { useState, useCallback } from 'react';
import { useAuth } from '@hooks/useAuth';
import { useToastManager } from '@components/ui/Toast';
import { cn } from '@utils';
import {
  Palette, Monitor, Bell, Shield, Database, Globe, Key, Trash2, Save, RefreshCw, Eye, EyeOff, ChevronDown,
} from 'lucide-react';

const THEMES = [
  { id: 'light', label: 'Claro', icon: Monitor },
  { id: 'dark', label: 'Escuro', icon: Monitor },
  { id: 'system', label: 'Sistema', icon: Monitor },
];

const LANGUAGES = [
  { code: 'pt-BR', label: 'Português (Brasil)', flag: '🇧🇷' },
  { code: 'en-US', label: 'English (US)', flag: '🇺🇸' },
  { code: 'es-ES', label: 'Español', flag: '🇪🇸' },
];

const CURRENCIES = [
  { code: 'BRL', label: 'Real Brasileiro (R$)', symbol: 'R$' },
  { code: 'USD', label: 'Dólar Americano ($)', symbol: '$' },
  { code: 'EUR', label: 'Euro (€)', symbol: '€' },
];

export function Settings() {
  const { user, isLoading: authLoading } = useAuth();
  const { success, danger, warning } = useToastManager();

  const [activeTab, setActiveTab] = useState<'appearance' | 'general' | 'notifications' | 'security' | 'data' | 'advanced'>('appearance');
  const [isSaving, setIsSaving] = useState(false);

  const [settings, setSettings] = useState({
    theme: 'system' as 'light' | 'dark' | 'system',
    language: 'pt-BR',
    currency: 'BRL',
    dateFormat: 'DD/MM/YYYY',
    timeFormat: '24h',
    timezone: 'America/Sao_Paulo',
    itemsPerPage: 15,
    compactMode: false,
    animations: true,
    emailNotifications: true,
    lowStockAlerts: true,
    movementAlerts: false,
    reportAlerts: true,
    weeklyDigest: false,
    twoFactorEnabled: false,
    sessionTimeout: 30,
    autoBackup: false,
    backupFrequency: 'daily',
    backupRetention: 30,
    apiAccess: false,
    debugMode: false,
  });

  const tabs = [
    { id: 'appearance', label: 'Aparência', icon: Palette },
    { id: 'general', label: 'Geral', icon: Globe },
    { id: 'notifications', label: 'Notificações', icon: Bell },
    { id: 'security', label: 'Segurança', icon: Shield },
    { id: 'data', label: 'Dados', icon: Database },
    { id: 'advanced', label: 'Avançado', icon: Key },
  ];

  const handleSave = async (e: React.FormEvent) => {
    e.preventDefault();
    setIsSaving(true);
    try {
      // Save to localStorage for demo
      localStorage.setItem('app-settings', JSON.stringify(settings));
      // TODO: Save to backend via API
      await new Promise((resolve) => setTimeout(resolve, 500));
      success('Sucesso', 'Configurações salvas com sucesso');
    } catch (error: unknown) {
      const message = error instanceof Error ? error.message : 'Erro ao salvar configurações';
      danger('Erro', message);
    } finally {
      setIsSaving(false);
    }
  };

  const handleReset = () => {
    const defaults = {
      theme: 'system' as const,
      language: 'pt-BR',
      currency: 'BRL',
      dateFormat: 'DD/MM/YYYY',
      timeFormat: '24h',
      timezone: 'America/Sao_Paulo',
      itemsPerPage: 15,
      compactMode: false,
      animations: true,
      emailNotifications: true,
      lowStockAlerts: true,
      movementAlerts: false,
      reportAlerts: true,
      weeklyDigest: false,
      twoFactorEnabled: false,
      sessionTimeout: 30,
      autoBackup: false,
      backupFrequency: 'daily',
      backupRetention: 30,
      apiAccess: false,
      debugMode: false,
    };
    setSettings(defaults);
    localStorage.removeItem('app-settings');
    warning('Configurações resetadas', 'As configurações foram restauradas para os padrões');
  };

  useEffect(() => {
    const saved = localStorage.getItem('app-settings');
    if (saved) {
      try {
        setSettings((prev) => ({ ...prev, ...JSON.parse(saved) }));
      } catch {
        // Ignore invalid JSON
      }
    }
    // Apply theme
    applyTheme(settings.theme);
  }, []);

  useEffect(() => {
    applyTheme(settings.theme);
  }, [settings.theme]);

  function applyTheme(theme: string) {
    const root = document.documentElement;
    if (theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      root.classList.add('dark');
    } else {
      root.classList.remove('dark');
    }
  }

  const handleSettingChange = <K extends keyof typeof settings>(key: K, value: typeof settings[K]) => {
    setSettings((prev) => ({ ...prev, [key]: value }));
  };

  return (
    <div className="settings-page">
      <div className="page-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
          <h1 className="h2 fw-bold mb-1">Configurações</h1>
          <p className="text-muted mb-0">Personalize o comportamento do sistema</p>
        </div>
        <div className="d-flex gap-2">
          <Button variant="outline-secondary" onClick={handleReset} disabled={isSaving}>
            <RefreshCw size={16} className="me-1" aria-hidden="true" />
            Restaurar Padrões
          </Button>
          <Button variant="primary" onClick={handleSave} disabled={isSaving}>
            {isSaving ? (
              <>
                <Spinner as="span" size="sm" className="me-1" aria-hidden="true" />
                Salvando...
              </>
            ) : (
              <>
                <Save size={16} className="me-1" aria-hidden="true" />
                Salvar Alterações
              </>
            )}
          </Button>
        </div>
      </div>

      <Row className="g-4">
        <Col lg={3}>
          <Card className="shadow-sm border-0 sticky-top" style={{ top: '24px' }}>
            <Card.Body className="p-0">
              <nav className="nav nav-pills flex-column" role="tablist">
                {tabs.map((tab) => (
                  <Button
                    key={tab.id}
                    role="tab"
                    aria-selected={activeTab === tab.id}
                    onClick={() => setActiveTab(tab.id as typeof activeTab)}
                    className={cn(
                      'nav-link',
                      'd-flex',
                      'align-items-center',
                      'gap-2',
                      'px-3',
                      'py-2.5',
                      'rounded-0',
                      'border-0',
                      'text-start',
                      activeTab === tab.id ? 'bg-primary-50 text-primary border-start border-3 border-primary' : 'text-dark hover:bg-light'
                    )}
                    variant={activeTab === tab.id ? 'primary' : 'ghost'}
                  >
                    <tab.icon size={18} aria-hidden="true" />
                    {tab.label}
                  </Button>
                ))}
              </nav>
            </Card.Body>
          </Card>
        </Col>

        <Col lg={9}>
          <div className="h-100">
            {activeTab === 'appearance' && <AppearanceSettings settings={settings} onChange={handleSettingChange} />}
            {activeTab === 'general' && <GeneralSettings settings={settings} onChange={handleSettingChange} />}
            {activeTab === 'notifications' && <NotificationSettings settings={settings} onChange={handleSettingChange} />}
            {activeTab === 'security' && <SecuritySettings settings={settings} onChange={handleSettingChange} />}
            {activeTab === 'data' && <DataSettings settings={settings} onChange={handleSettingChange} />}
            {activeTab === 'advanced' && <AdvancedSettings settings={settings} onChange={handleSettingChange} />}
          </div>
        </Col>
      </Row>
    </div>
  );
}

function AppearanceSettings({ settings, onChange }: { settings: any; onChange: (key: string, value: any) => void }) {
  return (
    <>
      <Card className="shadow-sm border-0 mb-4">
        <Card.Header className="bg-white border-0">
          <h5 className="mb-0 fw-semibold">Tema</h5>
        </Card.Header>
        <Card.Body>
          <div className="row g-3">
            {THEMES.map((theme) => (
              <Col key={theme.id} md={4}>
                <div
                  className={cn(
                    'theme-option p-4 border rounded-3 text-center cursor-pointer transition-all h-100',
                    settings.theme === theme.id ? 'border-primary bg-primary-50' : 'border-secondary hover:border-primary'
                  )}
                  onClick={() => onChange('theme', theme.id as 'light' | 'dark' | 'system')}
                  role="button"
                  tabIndex={0}
                  onKeyDown={(e) => { if (e.key === 'Enter' || e.key === ' ') onChange('theme', theme.id as 'light' | 'dark' | 'system'); }}
                >
                  <theme.icon size={32} className="mb-2 text-primary" aria-hidden="true" />
                  <div className="fw-semibold">{theme.label}</div>
                  <div className="text-muted small">Clique para selecionar</div>
                </div>
              </Col>
            ))}
          </div>
        </Card.Body>
      </Card>

      <Card className="shadow-sm border-0 mb-4">
        <Card.Header className="bg-white border-0">
          <h5 className="mb-0 fw-semibold">Preferências de Interface</h5>
        </Card.Header>
        <Card.Body>
          <div className="row g-3">
            <Col md={6}>
              <div className="form-check form-switch">
                <input
                  type="checkbox"
                  className="form-check-input"
                  id="compact-mode"
                  checked={settings.compactMode}
                  onChange={(e) => onChange('compactMode', e.target.checked)}
                />
                <label className="form-check-label fw-medium" htmlFor="compact-mode">Modo Compacto</label>
                <div className="form-text">Reduz o espaçamento entre elementos</div>
              </div>
            </Col>
            <Col md={6}>
              <div className="form-check form-switch">
                <input
                  type="checkbox"
                  className="form-check-input"
                  id="animations"
                  checked={settings.animations}
                  onChange={(e) => onChange('animations', e.target.checked)}
                />
                <label className="form-check-label fw-medium" htmlFor="animations">Animações</label>
                <div className="form-text">Ativar transições e animações suaves</div>
              </div>
            </Col>
          </div>
        </Card.Body>
      </Card>

      <Card className="shadow-sm border-0">
        <Card.Header className="bg-white border-0">
          <h5 className="mb-0 fw-semibold">Pré-visualização</h5>
        </Card.Header>
        <Card.Body>
          <div className="preview-area p-3 border rounded-3 bg-light">
            <div className="d-flex align-items-center gap-3 mb-3">
              <div className="bg-primary rounded-circle d-flex align-items-center justify-content-center" style={{ width: '48px', height: '48px' }}>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" aria-hidden="true">
                  <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
                  <polyline points="3.27 6.96 12 12.01 20.73 6.96" />
                  <line x1="12" y1="22.08" x2="12" y2="12" />
                </svg>
              </div>
              <div>
                <h6 className="mb-0">Produto Exemplo</h6>
                <small className="text-muted">Código: PROD-001</small>
              </div>
            </div>
            <div className="row g-2 text-center">
              <div className="col-4">
                <div className="p-2 bg-white rounded">
                  <div className="fw-bold text-success">R$ 29,90</div>
                  <small className="text-muted">Preço de Venda</small>
                </div>
              </div>
              <div className="col-4">
                <div className="p-2 bg-white rounded">
                  <div className="fw-bold text-primary">150</div>
                  <small className="text-muted">Em Estoque</small>
                </div>
              </div>
              <div className="col-4">
                <div className="p-2 bg-white rounded">
                  <div className="fw-bold text-warning">10</div>
                  <small className="text-muted">Mínimo</small>
                </div>
              </div>
            </div>
            <div className="mt-3">
              <span className="badge bg-success">Normal</span>
              <span className="badge bg-warning text-dark ms-1">Baixo</span>
              <span className="badge bg-danger ms-1">Crítico</span>
            </div>
          </div>
        </Card.Body>
      </Card>
    </>
  );
}

function GeneralSettings({ settings, onChange }: { settings: any; onChange: (key: string, value: any) => void }) {
  return (
    <>
      <Card className="shadow-sm border-0 mb-4">
        <Card.Header className="bg-white border-0">
          <h5 className="mb-0 fw-semibold">Localização e Idioma</h5>
        </Card.Header>
        <Card.Body>
          <div className="row g-3">
            <Col md={6}>
              <Form.Label>Idioma</Form.Label>
              <select className="form-select" value={settings.language} onChange={(e) => onChange('language', e.target.value)}>
                {LANGUAGES.map((lang) => (
                  <option key={lang.code} value={lang.code}>{lang.flag} {lang.label}</option>
                ))}
              </select>
            </Col>
            <Col md={6}>
              <Form.Label>Moeda</Form.Label>
              <select className="form-select" value={settings.currency} onChange={(e) => onChange('currency', e.target.value)}>
                {CURRENCIES.map((curr) => (
                  <option key={curr.code} value={curr.code}>{curr.symbol} {curr.label}</option>
                ))}
              </select>
            </Col>
            <Col md={4}>
              <Form.Label>Formato de Data</Form.Label>
              <select className="form-select" value={settings.dateFormat} onChange={(e) => onChange('dateFormat', e.target.value)}>
                <option value="DD/MM/YYYY">DD/MM/YYYY (31/12/2024)</option>
                <option value="MM/DD/YYYY">MM/DD/YYYY (12/31/2024)</option>
                <option value="YYYY-MM-DD">YYYY-MM-DD (2024-12-31)</option>
              </select>
            </Col>
            <Col md={4}>
              <Form.Label>Formato de Hora</Form.Label>
              <select className="form-select" value={settings.timeFormat} onChange={(e) => onChange('timeFormat', e.target.value)}>
                <option value="24h">24h (14:30)</option>
                <option value="12h">12h (2:30 PM)</option>
              </select>
            </Col>
            <Col md={4}>
              <Form.Label>Fuso Horário</Form.Label>
              <select className="form-select" value={settings.timezone} onChange={(e) => onChange('timezone', e.target.value)}>
                <option value="America/Sao_Paulo">America/Sao_Paulo (UTC-3)</option>
                <option value="America/Manaus">America/Manaus (UTC-4)</option>
                <option value="America/Recife">America/Recife (UTC-3)</option>
                <option value="America/Fortaleza">America/Fortaleza (UTC-3)</option>
                <option value="UTC">UTC (UTC+0)</option>
              </select>
            </Col>
          </div>
        </Card.Body>
      </Card>

      <Card className="shadow-sm border-0 mb-4">
        <Card.Header className="bg-white border-0">
          <h5 className="mb-0 fw-semibold">Tabela e Listagens</h5>
        </Card.Header>
        <Card.Body>
          <div className="row g-3">
            <Col md={6}>
              <Form.Label>Itens por Página</Form.Label>
              <select className="form-select" value={settings.itemsPerPage} onChange={(e) => onChange('itemsPerPage', parseInt(e.target.value))}>
                <option value={10}>10</option>
                <option value={15}>15</option>
                <option value={25}>25</option>
                <option value={50}>50</option>
                <option value={100}>100</option>
              </select>
            </Col>
          </div>
        </Card.Body>
      </Card>

      <Card className="shadow-sm border-0">
        <Card.Header className="bg-white border-0">
          <h5 className="mb-0 fw-semibold">Informações do Sistema</h5>
        </Card.Header>
        <Card.Body>
          <div className="system-info">
            <div className="info-item d-flex justify-content-between py-2 border-bottom">
              <span className="text-muted">Versão do Sistema</span>
              <span className="fw-medium">2.0.0</span>
            </div>
            <div className="info-item d-flex justify-content-between py-2 border-bottom">
              <span className="text-muted">Backend</span>
              <span className="fw-medium">NestJS + Neon Auth</span>
            </div>
            <div className="info-item d-flex justify-content-between py-2 border-bottom">
              <span className="text-muted">Frontend</span>
              <span className="fw-medium">React 18 + TypeScript + Vite</span>
            </div>
            <div className="info-item d-flex justify-content-between py-2">
              <span className="text-muted">Build</span>
              <span className="fw-medium">Produção</span>
            </div>
          </div>
        </Card.Body>
      </Card>
    </>
  );
}

function NotificationSettings({ settings, onChange }: { settings: any; onChange: (key: string, value: any) => void }) {
  const notificationOptions = [
    { key: 'emailNotifications', label: 'Notificações por E-mail', description: 'Receber notificações importantes por e-mail' },
    { key: 'lowStockAlerts', label: 'Alertas de Estoque Baixo', description: 'Notificar quando produtos atingirem o estoque mínimo' },
    { key: 'movementAlerts', label: 'Alertas de Movimentação', description: 'Notificar sobre entradas e saídas de estoque' },
    { key: 'reportAlerts', label: 'Relatórios Periódicos', description: 'Receber relatórios automáticos por e-mail' },
    { key: 'weeklyDigest', label: 'Resumo Semanal', description: 'Receber resumo semanal de atividades do sistema' },
  ];

  return (
    <Card className="shadow-sm border-0">
      <Card.Header className="bg-white border-0">
        <h5 className="mb-0 fw-semibold">Preferências de Notificação</h5>
      </Card.Header>
      <Card.Body>
        <div className="notification-list">
          {notificationOptions.map((opt) => (
            <div key={opt.key} className="notification-item d-flex justify-content-between align-items-center p-3 border-bottom">
              <div className="flex-1">
                <h6 className="mb-1">{opt.label}</h6>
                <p className="text-muted small mb-0">{opt.description}</p>
              </div>
              <Switch
                checked={settings[opt.key]}
                onChange={(e) => onChange(opt.key, e.target.checked)}
                id={opt.key}
              />
            </div>
          ))}
        </div>
      </Card.Body>
    </Card>
  );
}

function SecuritySettings({ settings, onChange }: { settings: any; onChange: (key: string, value: any) => void }) {
  const [show2FAModal, setShow2FAModal] = useState(false);
  const [totpSecret, setTotpSecret] = useState('');
  const [totpCode, setTotpCode] = useState('');

  return (
    <>
      <Card className="shadow-sm border-0 mb-4">
        <Card.Header className="bg-white border-0">
          <h5 className="mb-0 fw-semibold">Autenticação de Dois Fatores (2FA)</h5>
        </Card.Header>
        <Card.Body>
          <div className="d-flex justify-content-between align-items-center p-3 border rounded-3 bg-light">
            <div>
              <h6 className="mb-1">Autenticação de Dois Fatores</h6>
              <p className="text-muted small mb-0">Adicione uma camada extra de segurança à sua conta</p>
            </div>
            <div className="d-flex align-items-center gap-3">
              <Badge className={cn('fw-medium', settings.twoFactorEnabled ? 'bg-success' : 'bg-secondary')}>
                {settings.twoFactorEnabled ? 'Ativado' : 'Desativado'}
              </Badge>
              <Button
                variant={settings.twoFactorEnabled ? 'outline-danger' : 'outline-primary'}
                size="sm"
                onClick={() => {
                  if (settings.twoFactorEnabled) {
                    // Disable 2FA
                    onChange('twoFactorEnabled', false);
                    success('Sucesso', '2FA desativado');
                  } else {
                    setTotpSecret('JBSWY3DPEHPK3PXP'); // Demo secret
                    setShow2FAModal(true);
                  }
                }}
              >
                {settings.twoFactorEnabled ? 'Desativar' : 'Ativar'}
              </Button>
            </div>
          </div>
        </Card.Body>
      </Card>

      <Card className="shadow-sm border-0 mb-4">
        <Card.Header className="bg-white border-0">
          <h5 className="mb-0 fw-semibold">Sessão</h5>
        </Card.Header>
        <Card.Body>
          <div className="row g-3">
            <Col md={6}>
              <Form.Label>Tempo de Expiração da Sessão (minutos)</Form.Label>
              <InputGroup>
                <input
                  type="number"
                  className="form-control"
                  min="5"
                  max="480"
                  value={settings.sessionTimeout}
                  onChange={(e) => onChange('sessionTimeout', parseInt(e.target.value) || 30)}
                />
                <InputGroup.Text>min</InputGroup.Text>
              </InputGroup>
              <Form.Text>Tempo de inatividade antes do logout automático</Form.Text>
            </Col>
          </div>
          <div className="mt-3">
            <Button variant="outline-danger" size="sm">
              <Trash2 size={14} className="me-1" aria-hidden="true" />
              Encerrar Todas as Sessões
            </Button>
          </div>
        </Card.Body>
      </Card>

      <Card className="shadow-sm border-0">
        <Card.Header className="bg-white border-0">
          <h5 className="mb-0 fw-semibold">Acesso à API</h5>
        </Card.Header>
        <Card.Body>
          <div className="d-flex justify-content-between align-items-center p-3 border rounded-3 bg-light">
            <div>
              <h6 className="mb-1">Chaves de API</h6>
              <p className="text-muted small mb-0">Gerencie chaves de acesso para integrações externas</p>
            </div>
            <Button variant="outline-primary" size="sm">
              <Key size={14} className="me-1" aria-hidden="true" />
              Gerenciar Chaves
            </Button>
          </div>
        </Card.Body>
      </Card>

      <Modal show={show2FAModal} onHide={() => { setShow2FAModal(false); setTotpCode(''); }} size="md" centered title="Ativar 2FA">
        <Modal.Body>
          <Alert variant="info">
            <h6 className="mb-2">Configure seu autenticador</h6>
            <p className="mb-2">Escaneie o QR code abaixo com seu app autenticador (Google Authenticator, Authy, 1Password, etc.)</p>
            <div className="text-center mb-3">
              <div className="bg-white p-4 d-inline-block rounded border">
                <div className="text-center">
                  <strong>Chave secreta:</strong>
                  <code className="d-block mt-2 p-2 bg-light rounded font-monospace">{totpSecret}</code>
                </div>
              </div>
            </div>
            <p className="mb-3">Ou insira a chave manualmente: <code>{totpSecret}</code></p>
          </Alert>
          <Form.Label>Código de Verificação (6 dígitos)</Form.Label>
          <input
            type="text"
            className="form-control text-center fs-4 letter-spacing-2"
            maxLength={6}
            value={totpCode}
            onChange={(e) => setTotpCode(e.target.value.replace(/\D/g, ''))}
            placeholder="000000"
            autoComplete="one-time-code"
          />
        </Modal.Body>
        <Modal.Footer>
          <Button variant="secondary" onClick={() => { setShow2FAModal(false); setTotpCode(''); }}>
            Cancelar
          </Button>
          <Button variant="primary" onClick={() => { if (totpCode.length === 6) { onChange('twoFactorEnabled', true); setShow2FAModal(false); setTotpCode(''); success('Sucesso', '2FA ativado com sucesso'); } }}>
            Ativar 2FA
          </Button>
        </Modal.Footer>
      </Modal>
    </>
  );
}

function DataSettings({ settings, onChange }: { settings: any; onChange: (key: string, value: any) => void }) {
  const [showClearData, setShowClearData] = useState(false);

  return (
    <>
      <Card className="shadow-sm border-0 mb-4">
        <Card.Header className="bg-white border-0">
          <h5 className="mb-0 fw-semibold">Backup Automático</h5>
        </Card.Header>
        <Card.Body>
          <div className="row g-3">
            <Col md={6}>
              <div className="form-check form-switch mb-3">
                <input
                  type="checkbox"
                  className="form-check-input"
                  id="auto-backup"
                  checked={settings.autoBackup}
                  onChange={(e) => onChange('autoBackup', e.target.checked)}
                />
                <label className="form-check-label fw-medium" htmlFor="auto-backup">Backup Automático</label>
              </div>
            </Col>
          </div>
          <div className="row g-3" style={{ opacity: settings.autoBackup ? 1 : 0.5, pointerEvents: settings.autoBackup ? 'auto' : 'none' }}>
            <Col md={6}>
              <Form.Label>Frequência</Form.Label>
              <select className="form-select" value={settings.backupFrequency} onChange={(e) => onChange('backupFrequency', e.target.value)}>
                <option value="daily">Diário</option>
                <option value="weekly">Semanal</option>
                <option value="monthly">Mensal</option>
              </select>
            </Col>
            <Col md={6}>
              <Form.Label>Retenção (dias)</Form.Label>
              <input
                type="number"
                className="form-control"
                min="1"
                max="365"
                value={settings.backupRetention}
                onChange={(e) => onChange('backupRetention', parseInt(e.target.value) || 30)}
              />
            </Col>
          </div>
          <div className="mt-3">
            <Button variant="outline-primary" size="sm">
              <Database size={14} className="me-1" aria-hidden="true" />
              Criar Backup Agora
            </Button>
          </div>
        </Card.Body>
      </Card>

      <Card className="shadow-sm border-0 mb-4">
        <Card.Header className="bg-white border-0">
          <h5 className="mb-0 fw-semibold">Exportação de Dados</h5>
        </Card.Header>
        <Card.Body>
          <div className="d-flex flex-wrap gap-2">
            <Button variant="outline-secondary" size="sm">
              <Download size={14} className="me-1" aria-hidden="true" />
              Exportar Produtos (CSV)
            </Button>
            <Button variant="outline-secondary" size="sm">
              <Download size={14} className="me-1" aria-hidden="true" />
              Exportar Movimentações (CSV)
            </Button>
            <Button variant="outline-secondary" size="sm">
              <Download size={14} className="me-1" aria-hidden="true" />
              Exportar Fabricantes (CSV)
            </Button>
            <Button variant="outline-secondary" size="sm">
              <Download size={14} className="me-1" aria-hidden="true" />
              Backup Completo (JSON)
            </Button>
          </div>
        </Card.Body>
      </Card>

      <Card className="shadow-sm border-0 border-danger">
        <Card.Header className="bg-white border-0">
          <h5 className="mb-0 fw-semibold text-danger">Zona de Perigo</h5>
        </Card.Header>
        <Card.Body>
          <Alert variant="danger">
            <h6 className="mb-2">Limpar Todos os Dados</h6>
            <p className="mb-0">Esta ação removerá permanentemente todos os produtos, movimentações, fabricantes e configurações. Não pode ser desfeita.</p>
          </Alert>
          <Button variant="danger" onClick={() => setShowClearData(true)}>
            <Trash2 size={14} className="me-1" aria-hidden="true" />
            Limpar Todos os Dados
          </Button>
        </Card.Body>
      </Card>

      <Modal show={showClearData} onHide={() => setShowClearData(false)} size="sm" centered title="Confirmar limpeza total" confirmText="Limpar Tudo" confirmVariant="danger">
        <div className="text-center">
          <Trash2 className="text-danger mb-3" size={48} aria-hidden="true" />
          <h5>Tem certeza absoluta?</h5>
          <p className="text-muted">
            Todos os dados do sistema serão <strong>permanentemente excluídos</strong>. Esta ação não pode ser desfeita.
          </p>
          <div className="form-check mb-3">
            <input type="checkbox" className="form-check-input" id="confirm-clear" />
            <label className="form-check-label" htmlFor="confirm-clear">
              Confirmo que desejo excluir TODOS os dados permanentemente
            </label>
          </div>
        </div>
      </Modal>
    </>
  );
}

function AdvancedSettings({ settings, onChange }: { settings: any; onChange: (key: string, value: any) => void }) {
  return (
    <>
      <Card className="shadow-sm border-0 mb-4">
        <Card.Header className="bg-white border-0">
          <h5 className="mb-0 fw-semibold">Modo Desenvolvedor</h5>
        </Card.Header>
        <Card.Body>
          <div className="form-check form-switch mb-3">
            <input
              type="checkbox"
              className="form-check-input"
              id="debug-mode"
              checked={settings.debugMode}
              onChange={(e) => onChange('debugMode', e.target.checked)}
            />
            <label className="form-check-label fw-medium" htmlFor="debug-mode">Modo Debug</label>
            <div className="form-text">Mostrar logs detalhados, queries de rede e informações de performance no console</div>
          </div>
          <div className="form-check form-switch mb-3">
            <input
              type="checkbox"
              className="form-check-input"
              id="api-access"
              checked={settings.apiAccess}
              onChange={(e) => onChange('apiAccess', e.target.checked)}
            />
            <label className="form-check-label fw-medium" htmlFor="api-access">Acesso à API Externa</label>
            <div className="form-text">Permitir requisições de origens externas (CORS)</div>
          </div>
        </Card.Body>
      </Card>

      <Card className="shadow-sm border-0 mb-4">
        <Card.Header className="bg-white border-0">
          <h5 className="mb-0 fw-semibold">Cache e Performance</h5>
        </Card.Header>
        <Card.Body>
          <div className="d-flex justify-content-between align-items-center p-3 border rounded-3 bg-light">
            <div>
              <h6 className="mb-1">Cache do React Query</h6>
              <p className="text-muted small mb-0">Limpar cache de queries e forçar refetch de todos os dados</p>
            </div>
            <Button variant="outline-secondary" size="sm">
              <RefreshCw size={14} className="me-1" aria-hidden="true" />
              Limpar Cache
            </Button>
          </div>
        </Card.Body>
      </Card>

      <Card className="shadow-sm border-0">
        <Card.Header className="bg-white border-0">
          <h5 className="mb-0 fw-semibold">Logs e Diagnóstico</h5>
        </Card.Header>
        <Card.Body>
          <div className="d-flex flex-wrap gap-2">
            <Button variant="outline-secondary" size="sm">
              <FileText size={14} className="me-1" aria-hidden="true" />
              Ver Logs do Sistema
            </Button>
            <Button variant="outline-secondary" size="sm">
              <Download size={14} className="me-1" aria-hidden="true" />
              Exportar Logs
            </Button>
            <Button variant="outline-secondary" size="sm">
              <Trash2 size={14} className="me-1" aria-hidden="true" />
              Limpar Logs
            </Button>
          </div>
        </Card.Body>
      </Card>
    </>
  );
}

function success(message: string, description: string) {
  console.log('Success:', message, description);
}

function warning(message: string, description: string) {
  console.log('Warning:', message, description);
}

