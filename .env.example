# ============================================
# Estoque Cris - Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values
# For Vercel: Add these in Project Settings > Environment Variables
# For Neon Functions: Add in Neon Console > Project Settings > Environment Variables

# -----------------------------------------------------------------------------
# DATABASE (Neon PostgreSQL) - Backend only
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/database?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.region.aws.neon.tech/database?sslmode=require

# -----------------------------------------------------------------------------
# REDIS - Backend only (for caching, sessions, rate limiting)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# NEON AUTH - Backend & Frontend
# Get these from Neon Console > Auth > Settings
# -----------------------------------------------------------------------------
NEON_AUTH_BASE_URL=https://your-project.neonauth.region.aws.neon.tech
NEON_AUTH_JWKS_URL=https://your-project.neonauth.region.aws.neon.tech/.well-known/jwks.json
NEON_AUTH_AUDIENCE=neondb
NEON_AUTH_ISSUER=https://your-project.neonauth.region.aws.neon.tech

# -----------------------------------------------------------------------------
# NEON FUNCTIONS - Backend only
# -----------------------------------------------------------------------------
NEON_FUNCTION_HOST_SUFFIX=neonfunction.region.aws.neon.tech

# -----------------------------------------------------------------------------
# NEON OBJECT STORAGE (S3-compatible) - Backend only
# Get these from Neon Console > Storage > Settings
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_ENDPOINT_URL_S3=https://your-project.neonstorage.region.aws.neon.tech
AWS_REGION=us-east-1
AWS_S3_BUCKET=estoque-cris

# -----------------------------------------------------------------------------
# APP CONFIGURATION - Backend
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# FRONTEND (Vite/React) - Prefix with VITE_ to expose to client
# These MUST be set in Vercel Project Settings > Environment Variables
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api/v1
VITE_NEON_AUTH_BASE_URL=https://your-project.neonauth.region.aws.neon.tech

# -----------------------------------------------------------------------------
# PASSWORD RESET
# -----------------------------------------------------------------------------
PASSWORD_RESET_REDIRECT_URL=http://localhost:3000/reset-password

# -----------------------------------------------------------------------------
# JWT (fallback - not used with Neon Auth)
# -----------------------------------------------------------------------------
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# FILE UPLOAD - Backend only
# -----------------------------------------------------------------------------
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# -----------------------------------------------------------------------------
# EMAIL (for password reset) - Backend only
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password
EMAIL_FROM=noreply@estoque-cris.com

# -----------------------------------------------------------------------------
# MONITORING - Optional
# -----------------------------------------------------------------------------
SENTRY_DSN=
PROMETHEUS_PORT=9090

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------
FEATURE_NEON_AUTH=true
FEATURE_OBJECT_STORAGE=true
FEATURE_NEON_FUNCTIONS=true

# ============================================
# VERCEL DEPLOYMENT (Frontend only)
# ============================================
# These are set in Vercel Dashboard > Project > Settings > Environment Variables
# NOT in this file (they're injected at build time by Vercel)
#
# VERCEL_TOKEN=          # From Vercel Account Settings > Tokens
# VERCEL_ORG_ID=         # From Vercel Project Settings > General
# VERCEL_PROJECT_ID=     # From Vercel Project Settings > General
#
# Required for CI/CD (GitHub Actions secrets):
# - VERCEL_TOKEN
# - VERCEL_ORG_ID
# - VERCEL_PROJECT_ID
#
# Required for Preview Deployments (PRs):
# - VERCEL_TOKEN
# - VERCEL_ORG_ID
#
# Required for Production Deployments:
# - VERCEL_TOKEN
# - VERCEL_ORG_ID
# - VERCEL_PROJECT_ID