{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"],
      "cache": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": [],
      "cache": true
    },
    "test": {
      "outputs": ["coverage/**"],
      "cache": true
    },
    "test:cov": {
      "outputs": ["coverage/**"],
      "cache": true
    }
  },
  "globalDependencies": [".env*"],
  "globalEnv": [
    "DATABASE_URL",
    "NEON_AUTH_BASE_URL",
    "NEON_AUTH_JWKS_URL",
    "NEON_AUTH_AUDIENCE",
    "NEON_AUTH_ISSUER",
    "VITE_API_URL",
    "VITE_NEON_AUTH_BASE_URL"
  ]
}