# Frontend Environment Variables (Vite/React)
# Copy to .env.local for local development
# For Vercel: Add these in Project Settings > Environment Variables
# All variables MUST be prefixed with VITE_ to be exposed to the client

# API Backend URL
VITE_API_URL=http://localhost:5000/api/v1

# Neon Auth Base URL (for login redirects, etc.)
VITE_NEON_AUTH_BASE_URL=https://your-project.neonauth.region.aws.neon.tech

# Optional: Feature flags for frontend
# VITE_FEATURE_DARK_MODE=true
# VITE_FEATURE_BETA_FEATURES=false