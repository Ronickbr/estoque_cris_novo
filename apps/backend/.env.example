# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
BASE_URL=http://localhost:3000

# Database (Neon PostgreSQL)
# For local development with docker-compose, use:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/estoque_cris?sslmode=disable
# For Neon (production/staging):
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require
DATABASE_SSL=true

# Neon API (for branch management in CI/CD)
NEON_API_KEY=your-neon-api-key
NEON_PROJECT_ID=your-neon-project-id

# Neon Auth
NEON_AUTH_BASE_URL=https://your-project.neonauth.region.neon.tech/dbname/auth
NEON_AUTH_JWKS_URL=https://your-project.neonauth.region.neon.tech/dbname/auth/.well-known/jwks.json
NEON_AUTH_AUDIENCE=neondb
NEON_AUTH_ISSUER=https://your-project.neonauth.region.neon.tech/dbname/auth
PASSWORD_RESET_REDIRECT_URL=http://localhost:3000/reset-password

# JWT (legacy - kept for compatibility during transition)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Password Policy
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SYMBOLS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_LOCKOUT_MS=900000

# File Upload
UPLOAD_MAX_SIZE=5242880
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp
UPLOAD_DEST=./uploads

# Backup
BACKUP_DIR=./backups
BACKUP_MAX_FILES=30

# CORS
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Logging
LOG_LEVEL=debug
LOG_DIR=./log

# Swagger
SWAGGER_TITLE=Estoque Cris API
SWAGGER_DESCRIPTION=API do Sistema de Gerenciamento de Estoque
SWAGGER_VERSION=2.0.0
SWAGGER_PATH=api/docs

# GitHub Container Registry (for CI/CD)
GHCR_TOKEN=your-github-personal-access-token

# Staging Deployment (Fly.io / Railway / Render)
STAGING_DEPLOY_TARGET=fly.io
STAGING_FLY_APP=estoque-cris-staging
STAGING_FLY_REGION=gru
STAGING_FLY_TOKEN=your-fly-api-token
STAGING_RAILWAY_TOKEN=your-railway-token
STAGING_RAILWAY_SERVICE=estoque-cris-staging
STAGING_RENDER_API_KEY=your-render-api-key
STAGING_RENDER_SERVICE_ID=your-render-service-id
STAGING_NEON_DATABASE_URL=postgresql://user:pass@ep-staging.us-east-1.aws.neon.tech/dbname?sslmode=require
STAGING_BASE_URL=https://staging.estoque-cris.example.com

# Production Deployment
PROD_DEPLOY_TARGET=fly.io
PROD_FLY_APP=estoque-cris-prod
PROD_FLY_REGION=gru
PROD_FLY_TOKEN=your-fly-api-token
PROD_RAILWAY_TOKEN=your-railway-token
PROD_RAILWAY_SERVICE=estoque-cris-prod
PROD_RENDER_API_KEY=your-render-api-key
PROD_RENDER_SERVICE_ID=your-render-service-id
PROD_NEON_DATABASE_URL=postgresql://user:pass@ep-prod.us-east-1.aws.neon.tech/dbname?sslmode=require
PROD_BASE_URL=https://api.estoque-cris.example.com

# Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Security (optional)
SNYK_TOKEN=your-snyk-token
COSIGN_PRIVATE_KEY=your-cosign-private-key